# Backend target for Next.js rewrites (server-side). Browser calls stay same-origin (/api, /uploads).
# Usa 127.0.0.1 para evitar conflictos IPv6 con localhost.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Google Maps JS para el diálogo de ubicación (tiendas / servicios / anuncios).
# NO uses la key de Android: en web da ApiTargetBlockedMapError.
# Crea una key nueva en Cloud Console con:
#   - APIs: Maps JavaScript API + Geocoding API
#   - Restricción de app: HTTP referrers (http://localhost:3000/* y tu admin en Render)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
